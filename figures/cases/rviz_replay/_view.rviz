Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/map
      Style: Flat Squares
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Use Fixed Frame: true
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Markers
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /replay/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools: []
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: -1.3929443205736547
      Scale: 75.0
      X: 186.0713653564453
      Y: -240.22206115722656
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 1000
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 1000
  X: 100
  Y: 100
  collapsed: false
