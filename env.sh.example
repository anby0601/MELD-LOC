# Copy to env.sh and edit. Sourced by datagen/run_scenario.sh and datagen/generate.sh.
export ROS_SETUP=/opt/ros/humble/setup.bash            # ROS 2 Humble
export AUTOWARE_WS=$HOME/autoware                       # colcon workspace built from env/autoware_environment.md (has install/setup.bash)
export AUTOWARE_MAP_DIR=$HOME/autoware_map              # contains Town01/ and Town02/ (lanelet2_map.osm + pointcloud_map.pcd)
export CARLA_ROOT=$HOME/CARLA_0.9.15                    # CarlaUE4.sh lives here; the carla Python egg must be importable
export MELDLOC_DATA=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/data   # run logs are written under $MELDLOC_DATA/logs/<role>/
export DISPLAY=${DISPLAY:-:0}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
